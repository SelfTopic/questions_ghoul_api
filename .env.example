# Скопируйте в .env и заполните. Пароли — без символов @ : / (они подставляются в URL).

NODE_ENV=development
PORT=3300
# Порт на хосте для docker compose
API_PORT=3300
# Тег образа api/migrate. Если на одном хосте несколько проектов (прод + тестовый
# стенд), у каждого должен быть свой — иначе сборка одного перезапишет тег другого.
IMAGE_TAG=questions-ghoul-api:latest
# За reverse proxy: число прокси (1) или список подсетей. Иначе req.ip = адрес прокси.
TRUST_PROXY=false
# Список через запятую или *
CORS_ORIGINS=*

# openssl rand -base64 48
JWT_SECRET=

POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Для запуска без docker (в compose URL собираются из паролей выше)
POSTGRES_URL=postgres://postgres:password@localhost:5432/ghoul_db
REDIS_URL=redis://:password@localhost:6379
LOG_SQL=false

QUESTIONS_PATH=assets/data/processed/data.json
# "Кто это?" режим — опционален, нет файла — режим просто отключён
WHOIS_PATH=assets/data/processed/whois.json
# "Да/нет" режим — опционален, нет файла — режим просто отключён
TRUE_FALSE_PATH=assets/data/processed/true-false.json

# smtp | log (log — код пишется в консоль, запрещён в production)
EMAIL_TRANSPORT=smtp
# Либо EMAIL_SERVICE (gmail, yandex, ...; по умолчанию gmail), либо SMTP_HOST/SMTP_PORT/SMTP_SECURE
EMAIL_SERVICE=gmail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# EMAIL_FROM="Questions Ghoul API" <noreply@example.com>
