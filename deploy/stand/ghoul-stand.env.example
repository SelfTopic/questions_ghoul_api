# /etc/ghoul-stand.env — настройки деплоя стенда (в git не кладётся).
# Папка с клоном репозитория для стенда; в ней свой .env (POSTGRES_PASSWORD, REDIS_PASSWORD,
# JWT_SECRET, ...) и свой assets/data/processed/data.json — его так же, как и в проде, нужно
# положить туда руками один раз, сам он никогда не попадёт в git.
STAND_DIR=/root/ghoul_test
# Кому писать о деплое: твой Telegram id.
NOTIFY_CHAT_ID=123456789
# Токен бота для уведомлений. У questions_ghoul_api своего бота нет — можно использовать токен
# chestor_bot (или его тестовой копии), это не связывает два деплоя друг с другом.
BOT_TOKEN=
# Сервисы docker compose через пробел; зависимости (postgres, redis, migrate) поднимутся сами.
STAND_SERVICES=api
# Имя проекта docker compose для стенда.
STAND_PROJECT=ghoul_test
# Необязательно: токен GitHub без прав. Без него у API лимит 60 запросов в час с IP сервера.
# GITHUB_TOKEN=
